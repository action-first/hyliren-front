# ─── FO (중국 고객용) 환경변수 ─────────────────────────────
# 로컬: 이 파일을 .env.local 로 복사해 사용.
# Vercel: Project Settings → Environment Variables 에 동일 키로 등록.

# Customer 백엔드(hyliren-api/apps/customer) base URL.
# 브라우저 번들에 노출되는 공개 값이므로 시크릿 금지.
# 운영 예시: https://api.hyliren.com/customer
NEXT_PUBLIC_CUSTOMER_API_BASE_URL=http://localhost:3001/customer
