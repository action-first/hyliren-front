# ─── BO (Back Office / 운영자) 환경변수 ─────────────────────────────
# 로컬: 이 파일을 .env.local 로 복사해 사용.
# Vercel: Project Settings → Environment Variables 에 동일 키로 등록.

# ─── 인증 (필수) ─────────────────────────────────────────────────────
# 모드: 'mock' (실 BE 미연결, env 의 dev admin 자격 사용)
#       'real' (BE admin auth API 와 proxy)
BO_AUTH_MODE=mock

# Session HMAC 서명 키. 32자 이상 random hex 권장.
# 생성 예: openssl rand -hex 32
BO_AUTH_SECRET=replace-with-32+-char-random-hex-string-locally

# Session cookie 이름 (선택, 기본 'bo-session')
# BO_SESSION_COOKIE=bo-session

# Session 만료 ms (선택, 기본 8h = 28800000)
# BO_SESSION_TTL_MS=28800000

# ─── mock 모드 한정 (실 BE 미연결 dev/staging) ─────────────────────────
# admin 자격. 평문 비밀번호이므로 운영 환경에서 mock 사용 금지.
BO_DEV_ADMIN_EMAIL=admin@mi-myo.com
BO_DEV_ADMIN_PASSWORD=change-this-locally
BO_DEV_ADMIN_NAME=운영자

# ─── real 모드 한정 (BE admin auth 연결 시점에 활성화) ─────────────────
# Admin 백엔드 base URL (server-to-server). NEXT_PUBLIC_ X — 노출 금지.
# BO_BACKEND_URL=http://localhost:3003/admin

# 향후 BO 가 admin API (사용자 관리, 크레딧 부여 등) 호출 시 동일 server-side env 로
# proxy 라우트 핸들러가 사용. 클라이언트는 same-origin /api/admin/* 만 호출.
