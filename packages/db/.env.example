# ─── @hyliren/db — Prisma · PostgreSQL 연결 ───────────────────────────
# 로컬: 이 파일을 .env 로 복사해 사용 (gitignored).
#       cp packages/db/.env.example packages/db/.env
# Vercel: 운영 배포 시 같은 키를 Project Settings → Environment Variables 에 등록.

# ─── 필수 ─────────────────────────────────────────────────────────────
# PostgreSQL 연결 문자열. SSL 권장 (운영). pooled connection (PgBouncer 등) 권장.
# 형식 예시:
#   - 로컬 docker: postgresql://postgres:postgres@localhost:5432/hyliren
#   - 운영 (TLS): postgresql://USER:PASS@HOST:5432/hyliren?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hyliren?schema=public

# ─── 선택 ─────────────────────────────────────────────────────────────
# Direct connection (마이그레이션·prisma migrate 전용).
# Pooler (PgBouncer/Supavisor) 사용 시 prisma migrate 가 실패할 수 있어 별도 직접 연결을 받음.
# 로컬·일반 RDS 처럼 pooler 없으면 동일 값 또는 비워두면 됨.
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hyliren?schema=public

# ─── seed 한정 (첫 admin 계정 부트스트랩) ────────────────────────────────
# packages/db/prisma/seed.ts 가 사용. .env 기록 후 한 번만 실행.
# 실행 후엔 DB 의 hash 만 남고 본 평문은 제거 권장.
SEED_ADMIN_EMAIL=admin@mi-myo.com
SEED_ADMIN_PASSWORD=mimyo-launch-strong-password
SEED_ADMIN_NAME=운영자
