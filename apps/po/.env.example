# ─── PO (Partner Office) 환경변수 ─────────────────────────────
# 로컬: 이 파일을 .env.local 로 복사해 사용.
# Vercel: Project Settings → Environment Variables 에 동일 키로 등록.

# Partner 백엔드(hyliren-api/apps/partner) base URL.
# 브라우저 번들에 노출되는 공개 값이므로 시크릿 금지.
# 운영 예시: https://api.hyliren.com/partner
NEXT_PUBLIC_PARTNER_API_BASE_URL=http://localhost:3002/partner
