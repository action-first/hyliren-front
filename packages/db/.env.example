# ─── @hyliren/db — Prisma · PostgreSQL 연결 ───────────────────────────
# 본 파일 위치 : packages/db/.env.example  (committed reference)
# 채울 파일    : packages/db/.env           (gitignored, 로컬 dev 전용)
#
# 복사 명령    : cp packages/db/.env.example packages/db/.env
# Vercel       : 운영 배포 시 같은 키를 Project Settings → Environment Variables 에 등록.
#
# ⚠️ 작업 절대 원칙 (memory: feedback_db_safety_principles)
#   1. 로컬 dev 에선 반드시 로컬 docker postgres 만 연결. 운영/실DB 자격 X
#   2. .env 안에 운영 자격 (Railway · production · owner pwd 등) 들어있는지 매번 확인
#   3. migration / seed / db push / bulk DML 은 로컬 DB 에서만 실행
#   4. 운영 DB 영향 작업은 migration 파일 + 실행 가이드까지만 작성, 실행은 운영자


# ═════════════════════════════════════════════════════════════════
#  PostgreSQL 접속 정보 — 기본값 = 로컬 docker (hyliren-api/docker-compose)
#  hyliren-api 디렉토리에서 `docker compose up postgres -d` 1회 실행 후 사용
# ═════════════════════════════════════════════════════════════════

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hyliren
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable


# ─── 자동 조합 (위 5개 + SSL 채우면 자동 완성, 수정 불필요) ─────────
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSL_MODE}


# ═════════════════════════════════════════════════════════════════
#  마이그레이션 전용 직접 연결 (선택)
# ═════════════════════════════════════════════════════════════════
# pooler (PgBouncer/Supavisor 등) 환경에서만 별도 직접 연결 등록.
# 로컬 docker · 일반 RDS 면 위 DATABASE_URL 만으로 충분 → 비워두기.
DIRECT_URL=


# ═════════════════════════════════════════════════════════════════
#  첫 admin 계정 부트스트랩 (prisma:seed 가 사용)
# ═════════════════════════════════════════════════════════════════
# seed 1회 실행 후 DB 에 bcrypt hash 만 남음. 평문은 즉시 비우기 권장.
SEED_ADMIN_EMAIL=admin@mi-myo.com
SEED_ADMIN_PASSWORD=replace-with-strong-password-min-8-chars
SEED_ADMIN_NAME=운영자
