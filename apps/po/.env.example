# ─── PO (Partner Office) 환경변수 ─────────────────────────────
# 이 파일은 .env.local 로 복사해서 로컬 값으로 채워 쓰세요.

# Partner 백엔드 (hyliren-api) base URL.
# 다음 3가지 형식 모두 자동 정규화됨:
#   http://localhost:3002
#   http://localhost:3002/partner
#   http://localhost:3002/partner/api/v1
PARTNER_BACKEND_URL=http://localhost:3002/partner
BACKEND_URL=http://localhost:3002/partner/api/v1
