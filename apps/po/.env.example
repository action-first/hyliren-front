# ─── PO (Partner Office) 환경변수 ─────────────────────────────
# 이 파일은 .env.local 로 복사해서 로컬 값으로 채워 쓰세요.

# API 모드: 'mock' | 'real'
# - mock (기본): apps/po/src/app/api/procedures/* route handler 가 /tmp/hyliren-store.json 직접 조작
# - real: Partner 백엔드 (hyliren-api) 로 proxy. BACKEND_URL 필요.
API_MODE=mock

# 실서버 전환 시: Partner 백엔드 base URL.
# Partner app 은 port 3002, global prefix '/partner', procedure controller 경로 '/api/v1/procedures'
# 따라서 BACKEND_URL = http://localhost:3002/partner/api/v1
#
# BACKEND_URL=http://localhost:3002/partner/api/v1

# 프론트 컴포넌트에서 직접 호출 가능한 base URL (이 값이 아닌 API_MODE/BACKEND_URL 을 우선).
NEXT_PUBLIC_PARTNER_API_BASE_URL=http://localhost:9001
